# 复制为 .env 后按需修改
GATEWAY_TOKEN=change-me-in-prod-please

# 通达信行情缓存（秒），日内默认 1s
QUOTE_CACHE_TTL_SECONDS=1

# mootdx 心跳间隔（秒），防止长时间无请求掉线
HEARTBEAT_INTERVAL_SECONDS=60

# 可选：同花顺账户的 SelfStockInfo.json 路径（用于自选股加入价/日期等元数据）
# 形如 C:\同花顺\同花顺\mx_<账户哈希>\SelfStockInfo.json
# 不填则只读 doc/自选股.sel 文件（运行时不需要同花顺常驻）
THS_SELFSTOCK_JSON=
